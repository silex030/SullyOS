# ─────────────────────────────────────────────────────────────
# SullyOS VPS 后端 · 环境变量模板
# 真实密钥只存在于 VPS 的 /opt/sullyos/.env（chmod 600），永不入库。
# ─────────────────────────────────────────────────────────────

# 监听地址：所有服务只监听本机回环，由 Caddy 反代暴露 80/443
HOST=127.0.0.1

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ── instant-push（8831）──────────────────────────────────────
# Web Push VAPID 密钥对（生成：node bin/gen-vapid.js）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=amsg@sullyos.local
# 客户端调用令牌（前端 X-Client-Token / Authorization 校验）
AMSG_CLIENT_TOKEN=
# 大 payload 传输策略：multipart（默认，无需 DB）| d1 | auto
AMSG_OVERSIZE_TRANSPORT=multipart

# ── amsg（8832）──────────────────────────────────────────────
# 定时消息 AES-GCM 主密钥（SHA-256 派生加密 Key）
AMSG_SECRET_KEY=
AMSG_DB_PATH=/opt/sullyos/data/amsg.sqlite
# ── proactive-push（8833）────────────────────────────────────
# Worker 内部校验令牌（留空=不校验；建议与 AMSG_CLIENT_TOKEN 同值）
CLIENT_TOKEN=
# VAPID 主题（mailto:），Worker 生成 JWT 时使用
VAPID_SUBJECT=
# 心跳窗口毫秒数（默认 300000）
HEARTBEAT_WINDOW_MS=300000

# ── wake-bridge（8834）───────────────────────────────────────
# 唤醒桥校验令牌（X-Wake-Token；留空=开发模式放行，生产必须配置）
WAKE_BRIDGE_TOKEN=
# 转发目标（留空回退 127.0.0.1:8831/8833）
INSTANT_PUSH_URL=http://127.0.0.1:8831
PROACTIVE_PUSH_URL=http://127.0.0.1:8833

# ── heartbeat（8835）─────────────────────────────────────────
# 独立心跳收集器 DB（与 amsg/proactive 分开，避免共享）
HEARTBEAT_DB_PATH=/opt/sullyos/data/heartbeat.sqlite
# 存活判定窗口毫秒数（默认 300000）；每分钟 cron 清理 2× 窗口的死条目
# HEARTBEAT_WINDOW_MS=300000

# ── sullyos-home（8837）────────────────────────────────────
HOME_DB_PATH=/opt/sullyos/data/sullyos-home.sqlite

# ── 主代理（8830）· LLM（OpenAI 兼容，可多供应商 fallback）──
# 与 SullyOS App 内「API 预设」字段一一对应，可直接把 App 里的预设抄到这里。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# fallback 供应商（JSON 数组，按顺序尝试）
# 例：[{"baseUrl":"https://api.deepseek.com/v1","apiKey":"sk-...","model":"deepseek-chat"}]
LLM_FALLBACKS=
LLM_TIMEOUT_MS=120000

# MCP 会话循环：单轮工具调用上限（原 MAX_LOOPS=6 的配置化）
MCP_MAX_LOOPS=12
# MCP 工具服务器（JSON 数组，streamable HTTP）：
# [{"name":"xhs-mcp","url":"http://127.0.0.1:8810/mcp"},
#  {"name":"kaleidoscope-rp","url":"http://127.0.0.1:8788/mcp","token":"..."}]
MCP_SERVERS=
# 钉住工具：逗号分隔的工具名，从第 2 轮 MCP 循环起始终携带（参考类工具）
MCP_PINNED_TOOLS=
# amsg 服务地址（main-agent /v1/llm-credentials 直通代理与凭据联动）
AMSG_URL=http://127.0.0.1:8832
# GPT-SoVITS 语音合成地址（sullyos-home /home/speak 转调用；留空回退本机 9880）
GPT_SOVITS_URL=

# ── mastodon-mcp（8838）──────────────────────────────────────
# MCP 自身鉴权（浏览器经 ?target= 代理连接时放在条目 token 里）
MASTODON_MCP_TOKEN=
# 按身份多账号 JSON：[{"ownerId":"user","instance":"mastodon.social","handle":"@me","accessToken":"..."}]
MASTODON_ACCOUNTS=
# 一键绑定落盘文件（env 种子 + 文件合并，文件优先；chmod 600 目录）
MASTODON_ACCOUNTS_FILE=/var/lib/sullyos-mastodon/accounts.json
# 只读开关：1=写工具全拒（先上读时间线时打开）
MASTODON_READ_ONLY=1
# 审计日志路径（jsonl，不含 token 与正文全文）
MASTODON_AUDIT_LOG=/var/lib/sullyos-mastodon/audit.jsonl
# 匿名读公开流时的默认实例
MASTODON_DEFAULT_INSTANCE=mastodon.social
# MASTODON_MCP_PORT=8838

# ── 备份（已退役，2026-10-22）────────────────────────────────
# VPS 侧三通道自动备份（backup.sh / restore.sh / db-manifest）已删除，
# 备份改由前端「云端备份 → GitHub Releases / WebDAV」承担，
# 旧包的只读离线查看方式见 deploy/scripts/BACKUP-RETIRED.md。
# 下面只剩本机 dufs 存储（/webdav 中转读已有文件，不产生新备份）。
DUFS_PORT=8890
DUFS_AUTH=
DUFS_ROOT=/opt/sullyos/backups/webdav

# ── 部署（install.sh 使用）──────────────────────────────────
SULLYOS_DOMAIN=
ACME_EMAIL=

# 语音中转（无密钥！Key 永远走客户端请求头）
MINIMAX_REGION=
MINIMAX_GROUP_ID=
FISH_MODEL=

# ── Google 日历桥（独立 node 进程，端口 8841）────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/settings/google/callback
GOOGLE_SESSION_KEY=
GOOGLE_BRIDGE_TOKEN=
GOOGLE_BRIDGE_PORT=8841
